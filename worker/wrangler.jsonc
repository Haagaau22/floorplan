{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "floorplan-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_CLOCK_SKEW_SECONDS": "300",
    // Temporary while validating the editor. Replace with auth-worker.
    "ALLOW_UNAUTHENTICATED_EDITS": "true"
  },
  "r2_buckets": [
    {
      "binding": "FLOORPLANS",
      "bucket_name": "floorplan-data",
      "preview_bucket_name": "floorplan-data-preview"
    }
  ]
}
